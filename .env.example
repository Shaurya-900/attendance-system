# "supabase" (default) or "memory" (local demo / e2e tests only — never in production)
DATA_BACKEND=supabase

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only Google accounts on this domain can sign in (and they must also be on the roster)
ALLOWED_EMAIL_DOMAIN=yourcollege.edu

# Long random string: signs check-in challenges. Generate with: openssl rand -base64 32
APP_SECRET=

# Must match the deployed site exactly
WEBAUTHN_RP_ID=attendance.example.com
WEBAUTHN_ORIGIN=https://attendance.example.com

# Used to decide which calendar date a meeting falls on (semester boundaries)
APP_TIMEZONE=Asia/Kolkata
